{
  "version": 2,
  "trailingSlash": false,
  "installCommand": "echo 'No dependencies required'",
  "buildCommand": "echo 'No build step required'",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/src/index.html" },
    { "source": "/~", "destination": "/src/index.html" },
    { "source": "/style.css", "destination": "/src/style.css" },
    { "source": "/settings.js", "destination": "/src/settings.js" },
    { "source": "/shadow.png", "destination": "/src/shadow.png" }
  ]
}
